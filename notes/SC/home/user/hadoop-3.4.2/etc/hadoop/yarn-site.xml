<?xml version="1.0" encoding="UTF-8"?>

<configuration>
    <!-- 开启 YARN 日志聚合 -->
    <property>
        <name>yarn.log-aggregation-enable</name>
        <value>true</value>
    </property>
    
    <!-- 日志保留时间 -->
    <property>
        <name>yarn.log-aggregation.retain-seconds</name>
        <value>604800</value>
    </property>
    
    <!-- YARN 容器日志 -->
    <!-- 需要先启动 HDFS 后再创建对应的目录 -->
    <property>
        <name>yarn.nodemanager.remote-app-log-dir</name>
        <value>/yarn/logs</value>
    </property>
    
    <!-- 日志子目录 -->
    <property>
        <name>yarn.nodemanager.remote-app-log-dir-suffix</name>
        <value>logs</value>
    </property>
    
    <!-- 指向 HistoryServer -->
    <property>
        <name>yarn.log.server.url</name>
        <value>http://Master:19888/jobhistory/logs</value>
    </property>
    
    <!-- MapReduce Shuffle 服务 -->
    <!-- 负责 MapReduce 场景的 Map 输出传输 -->
    <property>
        <name>yarn.nodemanager.aux-services</name>
        <value>mapreduce_shuffle</value>
    </property>
    <property>
        <name>yarn.nodemanager.aux-services.mapreduce_shuffle.class</name>
        <value>org.apache.hadoop.mapred.ShuffleHandler</value>
    </property>
    
    <!-- ResourceManager 主机 -->
    <!-- 集群 ResourceManager 所在的主机名称，需要注意大小写，也可以填写主机的 IP 地址 -->
    <property>
        <name>yarn.resourcemanager.hostname</name>
        <value>Master</value>
    </property>
    
    <!-- ResourceManager 绑定到所有网卡 -->
    <property>
        <name>yarn.resourcemanager.bind-host</name>
        <value>0.0.0.0</value>
    </property>
    
    <!-- RM 各服务地址 -->
    <property>
        <name>yarn.resourcemanager.address</name>
        <value>Master:8032</value>
    </property>
    <property>
        <name>yarn.resourcemanager.scheduler.address</name>
        <value>Master:8030</value>
    </property>
    <property>
        <name>yarn.resourcemanager.resource-tracker.address</name>
        <value>Master:8031</value>
    </property>
    <property>
        <name>yarn.resourcemanager.admin.address</name>
        <value>Master:8033</value>
    </property>
    
    <!-- YARN Web UI -->
    <!-- 需要注意大小写，也可以填写主机的 IP 地址 -->
    <property>
        <name>yarn.resourcemanager.webapp.address</name>
        <value>Master:8088</value>
    </property>

    <!-- NodeManager 资源总量 -->
    <!-- 每台 NodeManager 可用资源上限 -->
    <property>
        <name>yarn.nodemanager.resource.memory-mb</name>
        <value>2048</value>
    </property>
    <property>
        <name>yarn.nodemanager.resource.cpu-vcores</name>
        <value>2</value>
    </property>

    <!-- Container 资源分配粒度 -->
    <!-- 控制单个 Container 的资源上下限，防止单任务抢光整台机器 -->
    <property>
        <name>yarn.scheduler.minimum-allocation-mb</name>
        <value>512</value>
    </property>
    <property>
        <name>yarn.scheduler.maximum-allocation-mb</name>
        <value>2048</value>
    </property>
    <property>
        <name>yarn.scheduler.minimum-allocation-vcores</name>
        <value>1</value>
    </property>
    <property>
        <name>yarn.scheduler.maximum-allocation-vcores</name>
        <value>2</value>
    </property>

    <!-- 内存安全检查 -->
    <!-- 关闭虚拟内存检查，避免 Spark 被误杀，保留物理内存检查，防止真正 OOM -->
    <property>
        <name>yarn.nodemanager.vmem-check-enabled</name>
        <value>false</value>
    </property>
    <property>
        <name>yarn.nodemanager.pmem-check-enabled</name>
        <value>true</value>
    </property>

    <!-- NodeManager 本地目录 -->
    <!-- YARN 容器本地数据、日志独立存放，需要先启动 HDFS 后再创建对应的目录 -->
    <property>
        <name>yarn.nodemanager.local-dirs</name>
        <value>/home/user/hadoopdata/yarn/local</value>
    </property>
    <property>
        <name>yarn.nodemanager.log-dirs</name>
        <value>/home/user/hadoopdata/yarn/logs</value>
    </property>

    <!-- Scheduler 类型 -->
    <!-- 支持多队列资源隔离， 为后续 capacity-scheduler.xml 做准备 -->
    <property>
        <name>yarn.resourcemanager.scheduler.class</name>
        <value>org.apache.hadoop.yarn.server.resourcemanager.scheduler.capacity.CapacityScheduler</value>
    </property>
    
    <!-- ApplicationMaster 资源 -->
    <!-- 控制 MR ApplicationMaster 内存，避免 AM 成为系统瓶颈 -->
    <property>
        <name>yarn.app.mapreduce.am.resource.mb</name>
        <value>1024</value>
    </property>
    <property>
        <name>yarn.app.mapreduce.am.command-opts</name>
        <value>-Xmx768m</value>
    </property>
</configuration>
